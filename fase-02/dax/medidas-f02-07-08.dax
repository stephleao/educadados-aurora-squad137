-- F02-07 | Classificação do atingimento das filiais
-- 100% ou mais significa meta atingida.
-- Retorna BLANK() se ambas as metas estão ausentes.
-- Caso uma única meta esteja ausente, o comportamento
-- depende dos percentuais; cenário não testado diretamente.

-- F02-12: rótulo "Ambas as metas" padronizado
-- para compatibilidade com a segmentação
-- de situação de atingimento.

Status Atingimento =
SWITCH(
TRUE(),
ISBLANK([Meta Valor Filial]) && ISBLANK([Meta Quantidade Filial]), BLANK(),
[% Atingimento Valor Filial] >= 1 && [% Atingimento Quantidade Filial] >= 1, "Ambas as metas",
[% Atingimento Valor Filial] >= 1, "Somente Valor",
[% Atingimento Quantidade Filial] >= 1, "Somente Quantidade",
"Nenhuma das metas"
)

-- F02-08 | Volume e conversão dos orçamentos
-- Conta códigos distintos de orçamento por status.
-- Conversão: orçamentos aprovados / gerados.
-- A análise mensal depende do relacionamento do
-- calendário com a data de criação do orçamento.

Orçamentos Gerados =
DISTINCTCOUNT(orcamentos[codigo_orcamento])

Orçamentos Aprovados =
CALCULATE(
[Orçamentos Gerados],
Orcamentos[Status] = "Aprovado"
)

Orçamentos Perdidos =
CALCULATE(
[Orçamentos Gerados],
Orcamentos[Status] = "Perdido"
)

Taxa de Conversão =
DIVIDE([Orçamentos Aprovados], [Orçamentos Gerados])

-- Medidas também publicadas pela Dani, relacionadas à F02-09
-- O desconto utiliza valores de vendas; confirmar
-- adequação ao escopo da F02-09.
-- Estas três medidas não foram validadas nesta revisão.

Desconto Médio Ponderado =
DIVIDE(
[Valor Bruto de Itens] - [Valor Líquido],
[Valor Bruto de Itens]
)

Valor Líquido Orçamentos = SUM(orcamentos[valor_liquido])

Valor Perdido =
CALCULATE(
[Valor Líquido Orçamentos],
orcamentos[status] = "Perdido"
)

