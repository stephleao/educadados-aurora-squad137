-- ==================================================
-- F02-06 | Contagem de Filiais por Faixas
-- Projeto: Painel Aurora - Fase 2
-- Responsável: Elide
-- Tabela no Power BI: _Medidas
--
-- Finalidade: contar filiais ativas, separadamente
-- por faixa de atingimento de valor e quantidade.
-- KEEPFILTERS preserva filtros existentes.
-- Pressupõe filiais[unidade_ativa] como booleano,
-- conforme as medidas testadas no PBIX.
-- ==================================================

Qtd Filiais Valor - 100% ou mais =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Valor] = "100% ou mais"
    )
)

Qtd Filiais Valor - 90 a 99 =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Valor] = "90% a 99%"
    )
)

Qtd Filiais Valor - Abaixo 90 =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Valor] = "Abaixo de 90%"
    )
)

Qtd Filiais Valor - Sem Meta =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Valor] = "Sem Meta"
    )
)

Qtd Filiais Qtd - 100% ou mais =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Qtd] = "100% ou mais"
    )
)

Qtd Filiais Qtd - 90 a 99 =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Qtd] = "90% a 99%"
    )
)

Qtd Filiais Qtd - Abaixo 90 =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Qtd] = "Abaixo de 90%"
    )
)

Qtd Filiais Qtd - Sem Meta =
CALCULATE(
    DISTINCTCOUNT(filiais[codigo_filial]),
    KEEPFILTERS(filiais[unidade_ativa] = TRUE()),
    FILTER(
        VALUES(filiais[codigo_filial]),
        [Faixa Atingimento Qtd] = "Sem Meta"
    )
)

