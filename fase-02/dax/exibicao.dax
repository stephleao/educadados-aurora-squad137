-- ==================================================
-- F02-05 | Faixas de Atingimento
-- Projeto: Painel Aurora - Fase 2
-- Responsável: Elide
-- Tabela no Power BI: _Medidas

-- Finalidade: Categorizar o atingimento das filiais.
-- Retorna texto para uso em apresentações e filtros.
-- ==================================================

Faixa Atingimento Qtd =
VAR vMetaQtd = [Meta Quantidade Filial]
VAR vAtingimentoQtd = [% Atingimento Qtd Filial]
RETURN
SWITCH(
TRUE(),
ISBLANK(vMetaQtd), "Sem Meta",
vAtingimentoQtd >= 1, "100% ou mais",
vAtingimentoQtd >= 0.90, "90% a menos de 100%",
vAtingimentoQtd < 0.90, "Abaixo de 90%",
"Não Classificado"
)
