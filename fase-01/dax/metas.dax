-- F01-09 | Metas por nível
-- Projeto: Painel Aurora - Fase 1
-- Responsável: Steph
-- Tabela inicial no Power BI: _Medidas
--
-- Os níveis Produto, Serviço, Vendedor e Profissional
-- são independentes e não devem ser somados entre si.
-- Medidas numéricas retornam BLANK() na ausência de meta.
-- A exibição "sem meta" é configurada nos visuais.


-- NÍVEL PRODUTO
-- Finalidade: metas por grupo de serviço.
-- Origem: metas_valor e metas_quantidade.
-- Contexto: mês, filial e grupo de serviço.
-- TREATAS aplica o filtro de grupo devido ao relacionamento
-- direto inativo; CROSSFILTER evita interferência via serviço.

Meta Valor Produto =
CALCULATE(
    SUM(metas_valor[meta_valor]),
    metas_valor[nivel] = "Produto",
    CROSSFILTER(
        servicos[codigo_servico],
        metas_valor[codigo_servico],
        NONE
    ),
    TREATAS(
        VALUES(grupos_servico[codigo_grupo_servico]),
        metas_valor[codigo_grupo_servico]
    )
)

Meta Quantidade Produto =
CALCULATE(
    SUM(metas_quantidade[meta_quantidade]),
    metas_quantidade[nivel] = "Produto",
    CROSSFILTER(
        servicos[codigo_servico],
        metas_quantidade[codigo_servico],
        NONE
    ),
    TREATAS(
        VALUES(grupos_servico[codigo_grupo_servico]),
        metas_quantidade[codigo_grupo_servico]
    )
)


-- NÍVEL SERVIÇO
-- Finalidade: metas por serviço individual.
-- Origem: metas_valor e metas_quantidade.
-- Contexto: mês, filial e serviço.

Meta Valor Serviço =
CALCULATE(
    SUM(metas_valor[meta_valor]),
    metas_valor[nivel] = "Serviço"
)

Meta Quantidade Serviço =
CALCULATE(
    SUM(metas_quantidade[meta_quantidade]),
    metas_quantidade[nivel] = "Serviço"
)


-- NÍVEL VENDEDOR
-- Finalidade: metas por vendedor.
-- Origem: metas_valor e metas_quantidade.
-- Contexto: mês, filial e vendedor.

Meta Valor Vendedor =
CALCULATE(
    SUM(metas_valor[meta_valor]),
    metas_valor[nivel] = "Vendedor"
)

Meta Quantidade Vendedor =
CALCULATE(
    SUM(metas_quantidade[meta_quantidade]),
    metas_quantidade[nivel] = "Vendedor"
)


-- NÍVEL PROFISSIONAL
-- Finalidade: metas por profissional.
-- Origem: metas_valor e metas_quantidade.
-- Contexto: mês, filial e profissional.

Meta Valor Profissional =
CALCULATE(
    SUM(metas_valor[meta_valor]),
    metas_valor[nivel] = "Profissional"
)

Meta Quantidade Profissional =
CALCULATE(
    SUM(metas_quantidade[meta_quantidade]),
    metas_quantidade[nivel] = "Profissional"
)

-- ==================================================
-- F01-10 | Metas consolidadas
-- Projeto: Painel Aurora - Fase 1
-- Responsável: Steph
-- Tabela inicial no Power BI: _Medidas
--
-- Filial: valor do nível Produto e quantidade
-- do nível Vendedor.
-- Cidade: soma das metas de suas filiais.
-- Rede: soma das metas de todas as filiais.
-- Metas consolidadas ignoram filtros de outros
-- cortes, preservando o contexto de período.


-- FILIAL
-- Origem: medidas da F01-09.
-- Contexto: mês, filial e cidade.
-- REMOVEFILTERS evita interferência de filtros
-- de grupo, serviço, vendedor e profissional.

Meta Valor Filial =
CALCULATE(
    [Meta Valor Produto],
    REMOVEFILTERS(grupos_servico),
    REMOVEFILTERS(servicos),
    REMOVEFILTERS(vendedores),
    REMOVEFILTERS(profissionais)
)

Meta Quantidade Filial =
CALCULATE(
    [Meta Quantidade Vendedor],
    REMOVEFILTERS(grupos_servico),
    REMOVEFILTERS(servicos),
    REMOVEFILTERS(vendedores),
    REMOVEFILTERS(profissionais)
)


-- CIDADE
-- Origem: medidas consolidadas de filial.
-- Contexto: mês e cidade selecionada.
-- SUMX soma as metas das filiais da cidade.

Meta Valor Cidade =
SUMX(
    VALUES(filiais[codigo_filial]),
    CALCULATE([Meta Valor Filial])
)

Meta Quantidade Cidade =
SUMX(
    VALUES(filiais[codigo_filial]),
    CALCULATE([Meta Quantidade Filial])
)


-- REDE
-- Origem: medidas consolidadas de filial.
-- Contexto: mês, considerando todas as filiais.
-- ALL(filiais) remove filtros da tabela de filiais.

Meta Valor Rede =
SUMX(
    ALL(filiais),
    CALCULATE([Meta Valor Filial])
)

Meta Quantidade Rede =
SUMX(
    ALL(filiais),
    CALCULATE([Meta Quantidade Filial])
)


